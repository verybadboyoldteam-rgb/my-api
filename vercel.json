{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/login",
      "dest": "api/index.js"
    },
    {
      "src": "/logout",
      "dest": "api/index.js"
    },
    {
      "src": "/sessions",
      "dest": "api/index.js"
    },
    {
      "src": "/sessions/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/",
      "dest": "index.html"
    }
  ]
}
